bles": [], "retrieval_allowed": false, "default_searchable": false, "quality_flags": ["pdf_text_extracted", "ocr_unverified"], "pdf_page_count": 28, "embedded_image_count": 1, "evaluation_academic_year": 2026, "evaluation_semester": 1}
